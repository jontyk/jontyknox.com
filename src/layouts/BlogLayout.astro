---
import BaseHead from "../components/BaseHead.astro";
import ThemeToggleScript from "../components/ThemeToggleScript.astro";

interface Props {
  title: string;
  description: string;
  ogType?: "article" | "website";
  activePath: string;
  subbarLeft?: string;
  subbarRight?: string;
  stylesheet?: "blog" | "fuel";
  noindex?: boolean;
}

const {
  title,
  description,
  ogType,
  activePath,
  subbarLeft = "Writing, occasionally",
  subbarRight = "Agents · Product · Tuscany",
  stylesheet = "blog",
  noindex = false,
} = Astro.props;
const blogActive = activePath === "/blog" || activePath.startsWith("/blog/");
const toolsActive = activePath === "/tools" || activePath === "/fuel";
const homeActive = activePath === "/";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogType={ogType} stylesheet={stylesheet} noindex={noindex} />
  </head>
  <body id="top">
    <div class="ledger-page">
      <header class="masthead">
        <div class="masthead-row">
          <a class="masthead-brand" href="/">Jonty Knox</a>
          <nav class="masthead-nav" aria-label="Primary">
            <a href="/" aria-current={homeActive ? "page" : undefined}>Home</a>
            <a href="/blog" aria-current={blogActive ? "page" : undefined}>All posts</a>
            <a href="/tools" aria-current={toolsActive ? "page" : undefined}>Tools</a>
            <a href="/rss.xml">RSS</a>
            <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">◐</button>
          </nav>
        </div>
        <div class="masthead-subbar">
          <span>{subbarLeft}</span>
          <span>{subbarRight}</span>
        </div>
      </header>
      <main class="ledger-main">
        <slot />
      </main>
      <footer class="ledger-footer">
        <span>© {year} Jonty Knox</span>
        <a href="#top">▲ Top</a>
      </footer>
    </div>
    <ThemeToggleScript />
  </body>
</html>
