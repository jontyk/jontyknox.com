---
import BlogLayout from "../../layouts/BlogLayout.astro";
---

<BlogLayout
  title="Fuel Calculator"
  description="Personal endurance drink-mix and fueling calculator."
  activePath="/tools/fuel"
  stylesheet="fuel"
  subbarLeft="Endurance fueling"
  subbarRight="Drink-mix planner"
>
  <div class="fuel">
    <div class="ledger-hero fuel-hero">
      <h1>Fuel <span class="accent">calculator</span></h1>
      <p>
        Homemade sports-drink recipe and timed schedule from your ride. Estimates only — weigh yourself
        before/after a ride for real sweat numbers. Not medical advice.
      </p>
    </div>

    <div class="fuel-grid">
      <form class="fuel-inputs" id="fuel-form" autocomplete="off">
        <fieldset>
          <legend>Ride</legend>
          <div class="fuel-duration">
            <span class="fuel-duration-head">
              Duration <output class="fuel-duration-value" id="duration-label">2:40</output>
            </span>
            <input type="hidden" name="durationMin" value="160" />
            <div class="fuel-chips" id="duration-chips" role="group" aria-label="Duration presets">
              <button type="button" data-min="60">1:00</button>
              <button type="button" data-min="90">1:30</button>
              <button type="button" data-min="120">2:00</button>
              <button type="button" data-min="150">2:30</button>
              <button type="button" data-min="180">3:00</button>
              <button type="button" data-min="240">4:00</button>
              <button type="button" data-min="300">5:00</button>
            </div>
            <div class="fuel-steppers">
              <button type="button" id="duration-minus" aria-label="Subtract 15 minutes">−15 min</button>
              <button type="button" id="duration-plus" aria-label="Add 15 minutes">+15 min</button>
            </div>
          </div>
          <label>Intensity (avg HR zone)
            <select name="intensity">
              <option value="z60">60–70%</option>
              <option value="z70" selected>70–80%</option>
              <option value="z80">80–90%</option>
              <option value="z90">90%+</option>
            </select>
          </label>
          <label>Bottles carried
            <select name="bottleCount">
              <option value="1">1 bottle</option>
              <option value="2" selected>2 bottles</option>
              <option value="3">3 bottles</option>
              <option value="4">4 bottles</option>
            </select>
          </label>
          <label>Bottle size
            <select name="bottleSizeMl">
              <option value="500">500 ml</option>
              <option value="650">650 ml</option>
              <option value="750" selected>750 ml</option>
              <option value="950">950 ml</option>
            </select>
          </label>
          <label>Body weight (kg) <input type="number" name="weightKg" min="30" max="150" step="1" value="72" /></label>
          <label>Temperature (°C) <input type="number" name="tempC" min="-10" max="45" step="1" value="15" /></label>
        </fieldset>

        <fieldset>
          <legend>Fueling</legend>
          <label>GI training
            <select name="gi">
              <option value="untrained">Untrained</option>
              <option value="moderate" selected>Moderately trained</option>
              <option value="well">Well trained</option>
            </select>
          </label>
          <label>Sweat sodium
            <select name="sweatSodium">
              <option value="low">Low (~500 mg/L)</option>
              <option value="typical" selected>Typical (~800 mg/L)</option>
              <option value="salty">Salty (~1200 mg/L)</option>
            </select>
          </label>
          <label>Custom carb target (g/hr, blank = suggested)
            <input type="number" name="customCarb" min="0" max="150" step="5" placeholder="suggested" />
          </label>
          <label>Malto:fructose ratio
            <select name="ratio">
              <option value="1:1">1:1 (plain table sugar)</option>
              <option value="2:1">2:1</option>
              <option value="1:0.8" selected>1:0.8</option>
            </select>
          </label>
        </fieldset>
      </form>

      <div class="fuel-results">
        <section class="fuel-summary">
          <h2 class="ledger-kicker">Targets</h2>
          <div class="fuel-stats">
            <div><span class="fuel-stat-value" id="r-carbs">–</span><span class="fuel-stat-label">carbs / hr</span></div>
            <div><span class="fuel-stat-value" id="r-fluid">–</span><span class="fuel-stat-label">fluid / hr</span></div>
            <div><span class="fuel-stat-value" id="r-sodium">–</span><span class="fuel-stat-label">sodium / hr</span></div>
            <div><span class="fuel-stat-value" id="r-kcal">–</span><span class="fuel-stat-label">total kcal</span></div>
          </div>
          <p class="fuel-note" id="r-deficit"></p>
          <p class="fuel-note fuel-hint" id="r-customhint" hidden></p>
          <p class="fuel-note fuel-hint" id="r-ratiohint" hidden></p>
        </section>

        <section class="fuel-recipe">
          <h2 class="ledger-kicker">Mix (whole session)</h2>
          <ul class="fuel-recipe-list" id="r-recipe"></ul>
          <p class="fuel-note" id="r-saltnote" hidden></p>
          <p class="fuel-warn" id="r-warn" hidden></p>
        </section>

        <section class="fuel-schedule">
          <h2 class="ledger-kicker">Schedule</h2>
          <p class="fuel-note">
            Equal sips of mix every 20 minutes. Take gels with plain water — not the mix — so your gut
            can absorb them; carry the extra water separately.
          </p>
          <table>
            <thead>
              <tr><th>Time</th><th>Drink now (ml)</th><th>Gels</th><th>Total drunk (ml)</th><th>Carbs so far (g)</th></tr>
            </thead>
            <tbody id="r-schedule"></tbody>
          </table>
        </section>
      </div>
    </div>
  </div>
</BlogLayout>

<script>
  import {
    effectiveCarb,
    fluidPlan,
    sodiumPlan,
    buildRecipe,
    buildSchedule,
    GEL_CARB_G,
    GEL_WATER_ML,
    HOT_TEMP_C,
    type FuelInputs,
    type Intensity,
    type GiTraining,
    type SweatSodium,
    type Ratio,
  } from "../../lib/fuel.ts";

  const STORAGE_KEY = "fuel-calc-v1";
  const form = document.getElementById("fuel-form") as HTMLFormElement;
  const durationField = form.elements.namedItem("durationMin") as HTMLInputElement;
  const durationLabel = document.getElementById("duration-label")!;
  const chips = Array.from(
    document.querySelectorAll<HTMLButtonElement>("#duration-chips button"),
  );

  const DURATION_MIN = 15;
  const DURATION_MAX = 24 * 60;

  function setDuration(min: number) {
    const clamped = Math.min(DURATION_MAX, Math.max(DURATION_MIN, min));
    durationField.value = String(clamped);
    durationLabel.textContent = `${Math.floor(clamped / 60)}:${String(clamped % 60).padStart(2, "0")}`;
    for (const chip of chips) {
      chip.setAttribute("aria-pressed", String(Number(chip.dataset.min) === clamped));
    }
    render();
  }

  function readInputs(): FuelInputs {
    const d = new FormData(form);
    const num = (k: string) => Number(d.get(k));
    const durationMin = num("durationMin");
    const customRaw = String(d.get("customCarb") ?? "").trim();
    return {
      hours: Math.floor(durationMin / 60),
      minutes: durationMin % 60,
      intensity: String(d.get("intensity")) as Intensity,
      weightKg: num("weightKg"),
      tempC: num("tempC"),
      gi: String(d.get("gi")) as GiTraining,
      sweatSodium: String(d.get("sweatSodium")) as SweatSodium,
      customCarb: customRaw === "" ? null : Number(customRaw),
      ratio: String(d.get("ratio")) as Ratio,
      bottleCount: num("bottleCount"),
      bottleSizeMl: num("bottleSizeMl"),
    };
  }

  function restore() {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return;
    try {
      const saved = JSON.parse(raw) as Record<string, unknown>;
      for (const el of Array.from(form.elements)) {
        const field = el as HTMLInputElement | HTMLSelectElement;
        if (!field.name || field.name === "durationMin" || !(field.name in saved)) continue;
        const v = saved[field.name];
        field.value = v === null || v === undefined ? "" : String(v);
      }
      if (typeof saved.hours === "number" && typeof saved.minutes === "number") {
        durationField.value = String(saved.hours * 60 + saved.minutes);
      }
    } catch {
      /* ignore corrupt storage */
    }
  }

  function save(i: FuelInputs) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(i));
  }

  const setText = (id: string, text: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  };

  function render() {
    const i = readInputs();
    save(i);

    const fluid = fluidPlan(i);
    const sodium = sodiumPlan(i);
    const recipe = buildRecipe(i);

    setText("r-carbs", `${Math.round(effectiveCarb(i))} g`);
    setText("r-fluid", `${fluid.plannedMlPerHr} ml`);
    setText("r-sodium", `${sodium.targetMgPerHr} mg`);
    setText("r-kcal", `${recipe.kcal}`);
    setText(
      "r-deficit",
      `Estimated sweat loss ~${fluid.lossMlPerHr} ml/hr — planned intake leaves ~${fluid.deficitMlPerHr} ml/hr deficit.`,
    );

    const customHint = document.getElementById("r-customhint")!;
    const customActive = i.customCarb !== null && i.customCarb > 0;
    customHint.hidden = !customActive;
    if (customActive) {
      customHint.textContent =
        "Custom carb target active — the GI training setting is ignored. Clear the field to use suggestions.";
    }

    const ratioHint = document.getElementById("r-ratiohint")!;
    const highCarb = effectiveCarb(i) >= 90 && (i.ratio === "1:1" || i.ratio === "2:1");
    ratioHint.hidden = !highCarb;
    if (highCarb) {
      ratioHint.textContent =
        "At ≥90 g/hr a 1:0.8 glucose:fructose blend supports higher total absorption.";
    }

    const recipeEl = document.getElementById("r-recipe")!;
    const items: string[] = [];
    const per = (n: number) => Math.round((n / recipe.mixBottles) * 10) / 10;
    if (recipe.mixBottles > 0) {
      const perBottleMl = Math.round(recipe.totalWaterMl / recipe.mixBottles);
      const fill = perBottleMl >= recipe.bottleSizeMl - 5 ? "full" : `~${perBottleMl} ml each`;
      items.push(
        `Fill ${recipe.mixBottles} × ${recipe.bottleSizeMl} ml bottle${recipe.mixBottles > 1 ? "s" : ""} with mix (${fill})`,
      );
      const perParts =
        recipe.tableSugarG > 0
          ? `${per(recipe.tableSugarG)} g table sugar (sucrose)`
          : `${per(recipe.maltoG)} g maltodextrin + ${per(recipe.fructoseG)} g fructose`;
      items.push(
        `${recipe.mixBottles > 1 ? "Each mix bottle" : "The mix bottle"}: ${perParts} + ${per(recipe.saltG)} g salt — ${recipe.concentrationPct}% carbs`,
      );
      if (recipe.mixBottles > 1) {
        const totalParts =
          recipe.tableSugarG > 0
            ? `${recipe.tableSugarG} g sugar`
            : `${recipe.maltoG} g maltodextrin, ${recipe.fructoseG} g fructose`;
        items.push(`Totals: ${totalParts}, ${recipe.saltG} g salt (~${recipe.saltTsp} tsp), ${(recipe.totalWaterMl / 1000).toFixed(2)} L water`);
      }
    }
    if (recipe.plainBottles > 0) {
      const hotNote =
        i.tempC >= HOT_TEMP_C
          ? ` (at ≥${HOT_TEMP_C} °C one water bottle is reserved: plain fluid empties faster than carb mix when hydration is the priority)`
          : "";
      items.push(
        `Fill ${recipe.plainBottles} × ${recipe.bottleSizeMl} ml bottle${recipe.plainBottles > 1 ? "s" : ""} with plain water — for gels and drinking to thirst${hotNote}`,
      );
    }
    if (recipe.gelCount > 0) {
      items.push(
        `Carry ${recipe.gelCount} × standard gel (25 g carbs each, ${recipe.gelCarbG} g total) — take each with ~${GEL_WATER_ML} ml of the plain water, not the mix`,
      );
    }

    const saltNote = document.getElementById("r-saltnote")!;
    saltNote.hidden = recipe.sodiumShortfallMg === 0;
    if (recipe.sodiumShortfallMg > 0) {
      saltNote.textContent =
        `Salt is capped at ~700 mg sodium/L for taste and absorption, leaving ~${recipe.sodiumShortfallMg} mg of your sodium target out of the bottle. ` +
        `Fine for most rides — on very hot days consider salt capsules taken with plenty of water.`;
    }
    recipeEl.innerHTML = items.map((t) => `<li>${t}</li>`).join("");

    const warn = document.getElementById("r-warn")!;
    const warnings: string[] = [];
    if (recipe.warning === "strong") {
      warnings.push(
        "Very concentrated (>12%) — raises GI-distress risk. Add water, split into stronger + plain-water bottles, or take some carbs as food/gels.",
      );
    } else if (recipe.warning === "soft") {
      warnings.push(
        "Above isotonic (>8%) — fine if gut-trained, especially with a glucose+fructose blend, but empties slower than a 6–8% drink.",
      );
    }
    if (recipe.refillShortfallMl > 0) {
      warnings.push(
        `Your bottles carry ~${recipe.refillShortfallMl} ml less than the ideal fluid plan — plan a refill stop or add a bottle.`,
      );
    }
    if (recipe.gelWaterShortMl > 0) {
      warnings.push(
        `You're ~${recipe.gelWaterShortMl} ml short of plain water for the gels — refill mid-ride or take gels near water stops.`,
      );
    }
    if (recipe.unmetCarbG > 10) {
      warnings.push(
        `~${Math.round(recipe.unmetCarbG)} g of the carb target doesn't fit in the bottles or the gel schedule — carry another bottle, lower the target, or add solid food.`,
      );
    }
    warn.hidden = warnings.length === 0;
    warn.innerHTML = warnings.map((w) => `<span>${w}</span>`).join("<br />");

    const tbody = document.getElementById("r-schedule")!;
    let mlSoFar = 0;
    let carbSoFar = 0;
    tbody.innerHTML = buildSchedule(i)
      .map((r) => {
        mlSoFar += r.drinkMl;
        carbSoFar += r.carbG + r.gels * GEL_CARB_G;
        const gelCell =
          r.gels > 0
            ? `${r.gels} gel${r.gels > 1 ? "s" : ""} + ~${r.gels * GEL_WATER_ML} ml water`
            : "–";
        return `<tr><td>${r.label}</td><td>${r.drinkMl}</td><td>${gelCell}</td><td>${Math.round(mlSoFar)}</td><td>${Math.round(carbSoFar)}</td></tr>`;
      })
      .join("");
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => setDuration(Number(chip.dataset.min)));
  }
  document.getElementById("duration-minus")!.addEventListener("click", () => {
    setDuration(Number(durationField.value) - 15);
  });
  document.getElementById("duration-plus")!.addEventListener("click", () => {
    setDuration(Number(durationField.value) + 15);
  });

  restore();
  setDuration(Number(durationField.value)); // syncs label + chips, then renders
  form.addEventListener("input", render);
</script>
